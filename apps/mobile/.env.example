# Copy to .env.local — EXPO_PUBLIC_* vars are bundled into the app (never put secrets here).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# During development point this at your PC's LAN IP running `npm run dev:web`, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
