# Copy to .env.local for local dev, and add the same keys in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HAC_CREDENTIALS_KEY=
# Any long random string; Vercel sends it to /api/cron/sync
CRON_SECRET=
